{
  "framework": null,
  "buildCommand": "pnpm run build",
  "outputDirectory": "artifacts/dav-fraol-portfolio/dist/public",
  "functions": {
    "api/[...path].mjs": {
      "includeFiles": "artifacts/api-server/dist/*.mjs"
    }
  },
  "rewrites": [
    {
      "source": "/:path((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
